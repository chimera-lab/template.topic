@startuml
title Document Relationships - Proposed Improvements (Red = New)

left to right direction

!define AGENT_COLOR #E3F2FD
!define PROMPT_COLOR #E0F7FA
!define KNOWLEDGE_COLOR #E8F5E9
!define DOC_COLOR #FFF3E0
!define NEW_AGENT_COLOR #FFCDD2
!define NEW_PROMPT_COLOR #FFCDD2
!define NEW_DOC_COLOR #FFCDD2

skinparam component {
  BorderColor #666666
  FontName Arial
  FontSize 11
}

skinparam arrow {
  Color #757575
}

package "Agents" {
  component "project-manager" as project_manager AGENT_COLOR
  component "prompt-engineer" as prompt_engineer AGENT_COLOR
  component "repository-manager" as repository_manager AGENT_COLOR
  component "technical-writer" as technical_writer AGENT_COLOR
  component "template-architect" as template_architect AGENT_COLOR
  component "organization-manager" as org_manager NEW_AGENT_COLOR
}

package "Prompts" {
  component "close-task" as close_task PROMPT_COLOR
  component "commit" as commit PROMPT_COLOR
  component "explain-issue" as explain_issue PROMPT_COLOR
  component "fix-context" as fix_context PROMPT_COLOR
  component "fix-docs" as fix_docs PROMPT_COLOR
  component "go" as go PROMPT_COLOR
  component "plan-execution" as plan_execution PROMPT_COLOR
  component "plan-milestone" as plan_milestone PROMPT_COLOR
  component "recover-task" as recover_task PROMPT_COLOR
  component "update-team" as update_team PROMPT_COLOR
  component "work" as work PROMPT_COLOR
  component "create-template" as create_template NEW_PROMPT_COLOR
  component "apply-template" as apply_template NEW_PROMPT_COLOR
  component "update-template" as update_template NEW_PROMPT_COLOR
  component "validate-template" as validate_template NEW_PROMPT_COLOR
}

package "Knowledge" {
  component "automation" as automation KNOWLEDGE_COLOR
  component "cmr" as cmr KNOWLEDGE_COLOR
  component "deployment" as deployment KNOWLEDGE_COLOR
  component "repository" as repository KNOWLEDGE_COLOR
}

package "Documentation" {
  component "ARCHITECTURE" as ARCHITECTURE DOC_COLOR
  component "CHANGELOG" as CHANGELOG DOC_COLOR
  component "CODE_OF_CONDUCT" as CODE_OF_CONDUCT DOC_COLOR
  component "CONTRIBUTING" as CONTRIBUTING DOC_COLOR
  component "DEVELOPMENT" as DEVELOPMENT DOC_COLOR
  component "ORGANIZATION" as ORGANIZATION DOC_COLOR
  component "README" as README DOC_COLOR
  component "ROADMAP" as ROADMAP DOC_COLOR
  component "SECURITY" as SECURITY DOC_COLOR
  component "STRUCTURE" as STRUCTURE DOC_COLOR
  component "ORG" as ORG NEW_DOC_COLOR
}

' ============================================
' EXISTING RELATIONSHIPS (Black)
' ============================================
automation --> DEVELOPMENT
automation --> README
automation --> cmr
close_task --> repository_manager
cmr --> ORGANIZATION
cmr --> README
cmr --> STRUCTURE
commit --> repository_manager
deployment --> CONTRIBUTING
deployment --> SECURITY
deployment --> automation
explain_issue --> project_manager
fix_context --> prompt_engineer
fix_docs --> technical_writer
plan_execution --> project_manager
plan_milestone --> project_manager
project_manager --> automation
project_manager --> deployment
project_manager --> repository
recover_task --> project_manager
repository --> CONTRIBUTING
repository --> DEVELOPMENT
repository_manager --> cmr
technical_writer --> deployment
technical_writer --> repository
template_architect --> cmr
update_team --> prompt_engineer

' ============================================
' NEW RELATIONSHIPS (Red)
' ============================================

' ========================================
' AGENTS → KNOWLEDGE (Red, Valid)
' ========================================

' Organization Manager (coordination hub)
org_manager -[#Red]-> automation
org_manager -[#Red]-> repository
org_manager -[#Red]-> cmr

' Template Architect expanded (uses more knowledge)
template_architect -[#Red]-> automation
template_architect -[#Red]-> repository

' Technical Writer expanded (uses knowledge bases)
technical_writer -[#Red]-> automation
technical_writer -[#Red]-> cmr

' Project Manager expanded (uses repository knowledge)
project_manager -[#Red]-> cmr

' Repository Manager expanded (uses automation)
repository_manager -[#Red]-> automation
repository_manager -[#Red]-> repository

' ========================================
' INTER-AGENT COORDINATION (Red)
' ========================================

' Hierarchy: org-manager coordinates project & repository managers
org_manager -[#Red]-> project_manager
org_manager -[#Red]-> repository_manager

' Project manager coordinates repository manager
project_manager -[#Red]-> repository_manager

' Template architect coordinates technical writer
template_architect -[#Red]-> technical_writer

' ========================================
' PROMPTS → AGENTS (Red)
' ========================================

' Orphaned prompts connected
go -[#Red]-> org_manager
work -[#Red]-> org_manager
work -[#Red]-> project_manager

' Template workflow prompts
create_template -[#Red]-> template_architect
apply_template -[#Red]-> repository_manager
update_template -[#Red]-> template_architect
validate_template -[#Red]-> technical_writer
validate_template -[#Red]-> template_architect

' ========================================
' KNOWLEDGE → DOCUMENTATION (Red, Fundamentation)
' ========================================

' CMR knowledge fundamentates docs
cmr -[#Red]-> ARCHITECTURE
cmr -[#Red]-> ORG

' Automation knowledge fundamentates docs
automation -[#Red]-> CONTRIBUTING
automation -[#Red]-> ROADMAP
automation -[#Red]-> CODE_OF_CONDUCT

' Repository knowledge fundamentates docs
repository -[#Red]-> CODE_OF_CONDUCT
repository -[#Red]-> CHANGELOG

' Deployment knowledge fundamentates docs
deployment -[#Red]-> ROADMAP

@enduml

' ============================================
' SUMMARY OF IMPROVEMENTS
' ============================================
' BEFORE: 5 agents, 11 prompts, 4 knowledge, 10 docs, ~30 relationships
' AFTER:  6 agents, 15 prompts, 4 knowledge, 11 docs, ~55 relationships
'
' NEW COMPONENTS (Red background):
' - 1 agent: organization-manager
' - 4 prompts: create-template, apply-template, update-template, validate-template
' - 1 doc: ORG.md
'
' NEW RELATIONSHIPS (Red arrows): ~25
' - Agents → Knowledge: 9 new connections
' - Inter-Agent coordination: 4 hierarchical relationships
' - Prompts → Agents: 8 new connections (orphaned prompts connected)
' - Knowledge → Docs: 7 new fundamentations
'
' ARCHITECTURE PRINCIPLES FOLLOWED:
' - ✅ Agents consume ONLY knowledge (no direct agent → doc)
' - ✅ Knowledge fundamentates documentation (knowledge → doc)
' - ✅ Prompts orchestrate agents (prompt → agent)
' - ✅ Inter-agent hierarchy established (coordination chain)
' - ✅ Appropriate abstraction for .topic (no implementation-specific agents)
